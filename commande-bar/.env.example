# Modèle de configuration. Pour travailler sur ton ordinateur, copie ce
# fichier en « .env.local » et remplis les valeurs. En ligne, ces mêmes
# variables se règlent dans Vercel → Settings → Environment Variables.
# Ne mets JAMAIS ces valeurs dans le code ni sur GitHub.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → « Publishable key » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Project Settings → API Keys → « Secret key » (sb_secret_…) — SECRÈTE
SUPABASE_SECRET_KEY=sb_secret_xxx
