# Modèle de configuration. Pour travailler sur ton ordinateur, copie ce
# fichier en « .env.local » et remplis les valeurs. En ligne, ces mêmes
# variables se règlent dans Vercel → Settings → Environment Variables.
# Ne mets JAMAIS ces valeurs dans le code ni sur GitHub.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → « Publishable key » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Project Settings → API Keys → « Secret key » (sb_secret_…) — SECRÈTE
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe (mode test) → Développeurs → Clés API → clé RESTREINTE recommandée (rk_test_…,
# permission « Checkout Sessions : écriture »), ou à défaut la clé secrète (sk_test_…) — SECRÈTE
STRIPE_SECRET_KEY=rk_test_xxx

# Stripe → Développeurs → Webhooks → ta destination → secret de signature (whsec_…) — SECRÈTE
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Facultatif : lecture des bons de livraison par l'IA (Claude).
# platform.claude.com → API Keys → Create Key (sk-ant-…) — SECRÈTE
# ANTHROPIC_API_KEY=sk-ant-xxx

# Facultatif : adresse publique du site utilisée dans les liens des cartes NFC et les QR codes
# (par défaut : le domaine de production Vercel). À régler si tu as ton propre nom de domaine.
# SITE_URL=https://commande.mon-domaine.fr
