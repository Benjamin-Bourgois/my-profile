# Copie ce fichier en « .env » puis remplis-le. Le fichier .env n'est jamais envoyé sur GitHub.

# --- Gmail ---
# Ton adresse Gmail
GMAIL_ADRESSE=prenom.nom@gmail.com
# Mot de passe d'application (16 lettres), PAS ton mot de passe Gmail.
# À créer sur https://myaccount.google.com/apppasswords (validation en deux étapes obligatoire)
GMAIL_MOT_DE_PASSE_APPLICATION=abcd efgh ijkl mnop

# --- Expéditeur ---
# Nom affiché dans la boîte du prospect
EXPEDITEUR_NOM=Benjamin Bourgois
# Signature ajoutée sous chaque email (\n = retour à la ligne)
EXPEDITEUR_SIGNATURE=Benjamin Bourgois\nCommande à table pour les bars\n06 00 00 00 00

# --- Claude (rédaction des emails) ---
# Clé API à créer sur https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Rythme d'envoi ---
# Nombre maximum d'emails envoyés par jour (relances comprises). Commence bas : 15 à 20.
LIMITE_PAR_JOUR=20
# Pause aléatoire entre deux envois, en secondes
DELAI_MIN_SECONDES=60
DELAI_MAX_SECONDES=180
# Relances sans réponse : nombre de jours après le premier email
RELANCE_1_JOURS=3
RELANCE_2_JOURS=7

# --- Validation ---
# oui : tu relis et valides chaque email avant l'envoi (conseillé)
# non : les emails rédigés par Claude partent directement
VALIDATION_MANUELLE=oui
